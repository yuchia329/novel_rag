# ── Embeddings (local by default; runs on your Mac M4 via MPS) ─────────────
EMBEDDING_PROVIDER=bge-m3            # bge-m3 | minimax
LOCAL_EMBED_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANKER=true
DEVICE=mps                          # mps | cpu | cuda

# ── MiniMax (answer generation; optional cloud embeddings) ─────────────────
# Get these from the MiniMax console. The chat endpoint is OpenAI-compatible.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=                   # optional, only some endpoints need it
MINIMAX_BASE_URL=https://api.minimax.io/v1     # use https://api.minimaxi.com/v1 for mainland China
# Model IDs change often — set this to whatever your account exposes (check the console).
MINIMAX_CHAT_MODEL=MiniMax-Text-01
MINIMAX_EMBED_MODEL=embo-01
# Reasoning models (e.g. MiniMax-M3) spend most latency on hidden thinking.
# minimal|low|medium|high (or empty for the model default). Lower = much faster.
MINIMAX_REASONING_EFFORT=minimal

# Batch jobs (KG extraction, eval question synthesis): a fast model is plenty.
KG_MODEL=MiniMax-M3.1-Flash
QA_GEN_MODEL=MiniMax-M3.1-Flash
LLM_WORKERS=8                       # parallel requests for batch jobs
LLM_CACHE=true                      # sqlite response cache (reproducible, free re-runs)

# LLM-as-judge. Empty = reuse the chat model. Prefer a different model family
# (any OpenAI-compatible endpoint) to reduce self-preference bias.
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# ── Chunking / retrieval knobs ─────────────────────────────────────────────
CHUNK_PROFILE=sent-512              # fixed-512 | sent-256 | sent-512 | sent-1024 | pc-128-768
HYBRID_CANDIDATES=30                # candidates pulled from each of vector + BM25 before fusion
RERANK_INPUT=30                     # how many fused candidates to rerank
TOP_K=8                             # passages handed to the LLM
USE_GRAPH=true                      # knowledge-graph-augmented retrieval (when a KG exists)

# ── Scraping (be polite; see README legal note) ───────────────────────────
USER_AGENT=novel-rag/0.1 (personal research)
REQUEST_DELAY_SECONDS=1.5
MAX_RETRIES=4
SCRAPE_ENABLED=true                 # global kill-switch for network fetches

# ── Paths ──────────────────────────────────────────────────────────────────
DATA_DIR=./data
